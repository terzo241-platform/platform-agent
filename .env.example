# Ford Platform Agent Configuration

# --- LLM ---
# Primary model for tool routing (Gemini Flash = cheapest, sufficient for routing)
FORD_AGENT_MODEL=gemini-2.5-flash
# Reasoning model for complex tasks (Claude Sonnet via Vertex AI)
FORD_AGENT_REASONING_MODEL=claude-sonnet-5

# --- GitHub ---
GITHUB_TOKEN=ghp_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
GITHUB_ORG=terzo241-platform

# --- ArgoCD ---
ARGOCD_SERVER=https://argocd.example.com
ARGOCD_TOKEN=
# If using Kubernetes service account instead of token:
# ARGOCD_USE_KUBE_AUTH=true

# --- Tekton ---
TEKTON_API_URL=
TEKTON_NAMESPACE=tekton-pipelines

# --- GCP ---
GOOGLE_CLOUD_PROJECT=
GOOGLE_CLOUD_REGION=asia-south1

# --- Guardrails ---
# Environments where destructive actions require human approval
FORD_APPROVAL_REQUIRED_ENVS=prod,production
# Max concurrent deployments per team
FORD_MAX_CONCURRENT_DEPLOYS=3
# Rate limit: max agent actions per minute
FORD_RATE_LIMIT_PER_MIN=30

# --- Chat Server ---
# Bind address and port
FORD_CHAT_HOST=0.0.0.0
FORD_CHAT_PORT=8080
# CORS: comma-separated origins (* = allow all, use specific origins in prod)
FORD_CHAT_CORS_ORIGINS=*
# API keys: comma-separated. Empty = dev mode (no auth required)
FORD_CHAT_API_KEYS=
# Session TTL in hours (sessions expire after this)
FORD_CHAT_SESSION_TTL_HOURS=24
# Max concurrent sessions per user
FORD_CHAT_MAX_SESSIONS_PER_USER=10
# Rate limit: max messages per minute per user
FORD_CHAT_RATE_LIMIT_PER_MINUTE=30

# --- Audit ---
FORD_AUDIT_DATASET=platform_agent_audit
FORD_AUDIT_TABLE=actions
